<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calcul Lean Body Mass"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/app_text_primary"
            android:gravity="center"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sexe"
            android:textStyle="bold"
            android:textColor="@color/app_text_primary"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbMale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Homme"
                android:checked="true"
                android:textColor="@color/app_text_primary"
                android:buttonTint="@color/app_black"
                android:layout_marginEnd="24dp" />

            <RadioButton
                android:id="@+id/rbFemale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Femme"
                android:textColor="@color/app_text_primary"
                android:buttonTint="@color/app_black" />
        </RadioGroup>

        <EditText
            android:id="@+id/etWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Poids en kg"
            android:inputType="numberDecimal"
            android:padding="14dp"
            android:background="@drawable/bg_input"
            android:textColor="@color/app_text_primary"
            android:textColorHint="@color/app_text_secondary"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/etHeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Taille en cm"
            android:inputType="numberDecimal"
            android:padding="14dp"
            android:background="@drawable/bg_input"
            android:textColor="@color/app_text_primary"
            android:textColorHint="@color/app_text_secondary"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calculer"
            android:textColor="@color/app_white"
            android:background="@drawable/bg_button_black"
            android:backgroundTint="@color/app_black"
            android:minHeight="48dp"
            android:padding="12dp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/app_text_primary"
            android:background="@drawable/bg_history_item"
            android:gravity="center"
            android:padding="16dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="17sp"
            android:textColor="@color/app_text_primary"
            android:gravity="center"
            android:padding="12dp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voir historique"
            android:textColor="@color/app_white"
            android:background="@drawable/bg_button_black"
            android:backgroundTint="@color/app_black"
            android:minHeight="48dp"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Déconnexion"
            android:textColor="@color/app_white"
            android:background="@drawable/bg_button_black"
            android:backgroundTint="@color/app_black"
            android:minHeight="48dp"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>
