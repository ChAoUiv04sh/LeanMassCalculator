<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_history_item"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/tvHistoryResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LBM = 56.02 kg"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/app_text_primary" />

    <TextView
        android:id="@+id/tvHistoryDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Homme | Poids: 70kg | Taille: 175cm"
        android:textSize="14sp"
        android:textColor="@color/app_text_secondary"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/tvHistoryStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Résultat satisfaisant"
        android:textSize="14sp"
        android:textColor="@color/app_text_primary"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/tvHistoryDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="23/05/2026 16:30"
        android:textSize="13sp"
        android:textColor="@color/app_text_secondary"
        android:layout_marginTop="6dp" />

    <Button
        android:id="@+id/btnDeleteItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Supprimer"
        android:textColor="@color/app_white"
        android:background="@drawable/bg_button_black"
        android:backgroundTint="@color/app_black"
        android:minHeight="48dp"
        android:layout_marginTop="10dp" />

</LinearLayout>
